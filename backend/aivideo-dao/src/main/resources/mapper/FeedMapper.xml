<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- namespace 对应 Mapper 接口全限定名；每个 <select> 的 id 对应接口中的同名方法 -->
<mapper namespace="com.sun.aivideo.dao.FeedMapper">

    <resultMap id="FeedItemResultMap" type="com.sun.aivideo.dao.bo.FeedItemBO">
        <result column="feed_type"  property="feedType"/>
        <result column="id"         property="id"/>
        <result column="user_id"    property="userId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!--
        FeedMapper#selectFeedPage：视频与图片合并，按创建时间倒序，分页由 MyBatis-Plus 插件处理。
        feedType 为空时两种都查；为 VIDEO / IMAGE 时只查一种。
    -->
    <select id="selectFeedPage" resultMap="FeedItemResultMap">
        SELECT task_type AS feed_type, id, user_id, created_at
        FROM t_generation_task
        WHERE deleted = 0
        <if test="feedType != null and feedType != ''">
            AND task_type = #{feedType}
        </if>
        <if test="userId != null">
            AND user_id = #{userId}
        </if>
        <if test="keyword != null and keyword != ''">
            AND prompt LIKE CONCAT('%', #{keyword}, '%')
        </if>
        ORDER BY created_at DESC, id DESC, task_type DESC
    </select>

</mapper>
