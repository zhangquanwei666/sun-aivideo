<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.sun</groupId>
    <artifactId>sun-aivideo-backend</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>sun-aivideo-backend</name>
    <description>AI 短视频生成后端（父工程）</description>

    <modules>
        <!-- 通用：枚举、统一响应体、业务异常 -->
        <module>aivideo-common</module>
        <!-- AI 核心：统一模型、策略接口、工厂与 Mock，不依赖厂商适配、数据库与 Web 层 -->
        <module>aivideo-ai-core</module>
        <!-- 厂商适配：阿里云百炼 / Google Gemini，均只依赖 AI 核心模块 -->
        <module>aivideo-ai-channel-dashscope</module>
        <module>aivideo-ai-channel-gemini</module>
        <!-- 数据访问：实体、Mapper、建表 SQL -->
        <module>aivideo-dao</module>
        <!-- 前台 Web 服务：controller / service，用户登录注册、视频与图片生成、费用与耗时统计 -->
        <module>aivideo-server</module>
        <!-- 管理后台服务（独立启动）：管理员登录、用户管理、全部生成记录 -->
        <module>aivideo-admin</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <langchain4j.version>1.8.0</langchain4j.version>
        <lombok.version>1.18.40</lombok.version>
        <sa-token.version>1.44.0</sa-token.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.sun</groupId>
                <artifactId>sun-aivideo-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sun</groupId>
                <artifactId>sun-aivideo-ai-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sun</groupId>
                <artifactId>sun-aivideo-ai-channel-dashscope</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sun</groupId>
                <artifactId>sun-aivideo-ai-channel-gemini</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sun</groupId>
                <artifactId>sun-aivideo-dao</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-open-ai</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>
            <!-- Sa-Token：登录鉴权 -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <!-- Sa-Token 集成 Redis：登录态存到 Redis，重启不掉线，前台与管理后台共享 -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-template</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 默认跳过 spring-boot:run，只有 aivideo-server 打开，这样在父工程目录也能直接启动 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
