{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "mvn.cmd",
      "runtimeArgs": ["-q", "-f", "backend/pom.xml", "spring-boot:run"],
      "port": 18088,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["frontend/node_modules/vite/bin/vite.js", "frontend", "--config", "frontend/vite.config.js", "--port", "25173", "--strictPort"],
      "port": 25173
    }
  ]
}
